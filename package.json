{
  "name": "chat-rooms-app",
  "version": "1.0.0",
  "private": true,
  "description": "E2E-encrypted, QR-invite chat rooms. Monorepo: server + client + shared.",
  "workspaces": [
    "server",
    "client",
    "shared"
  ],
  "scripts": {
    "dev": "npm --workspace @chat/server run dev",
    "build": "npm --workspace @chat/client run build",
    "start": "cross-env NODE_ENV=production npm --workspace @chat/server run start",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20"
  }
}